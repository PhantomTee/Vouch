NEXT_PUBLIC_APP_NAME=Vouch
NEXT_PUBLIC_SITE_URL=https://vouch-proof.vercel.app
NEXT_PUBLIC_SUI_NETWORK=testnet

# Auth
GITHUB_ID=
GITHUB_SECRET=
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# Optional AI judge assistant (server-only)
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

# Tatum RPC (server-only — never use NEXT_PUBLIC_ prefix for these keys)
TATUM_API_KEY=
TATUM_SUI_RPC_URL=https://sui-testnet.gateway.tatum.io
TATUM_API_KEY_MAINNET=
TATUM_SUI_RPC_URL_MAINNET=https://sui-mainnet.gateway.tatum.io

# Sui package IDs (public — read by client-side transaction builders)
NEXT_PUBLIC_PACKAGE_ID=
NEXT_PUBLIC_GRANTS_PACKAGE_ID=
NEXT_PUBLIC_PACKAGE_ID_MAINNET=
NEXT_PUBLIC_GRANTS_PACKAGE_ID_MAINNET=

# Walrus endpoints (public)
NEXT_PUBLIC_WALRUS_PUBLISHER_URL=https://publisher.walrus-testnet.walrus.space
NEXT_PUBLIC_WALRUS_AGGREGATOR_URL=https://aggregator.walrus-testnet.walrus.space
NEXT_PUBLIC_WALRUS_PUBLISHER_URL_MAINNET=https://walrus-mainnet-publisher-1.staketab.org
NEXT_PUBLIC_WALRUS_AGGREGATOR_URL_MAINNET=https://aggregator.walrus-mainnet.walrus.space
